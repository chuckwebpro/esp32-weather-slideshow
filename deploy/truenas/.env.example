# Host bind mount — child of Apps dataset (replace POOL with your pool name)
APPDATA_PATH=/mnt/apps/esp32-weather-slideshow

# Location — Collin County, TX area
SLIDESHOW_LAT=33.20
SLIDESHOW_LON=-96.70

# Radar crop box (optional; defaults target NE DFW / Collin — lon_w, lat_s, lon_e, lat_n)
# RADAR_BBOX=-97.08,32.78,-96.28,33.82
# RIDGE_OFFSET_KM_EAST=16.093
# RIDGE_OFFSET_KM_NORTH=0
TZ=America/Chicago

# Client hints (also set in compose environment)
REFRESH_AFTER_SEC=45
PLAYBACK_ADVANCE_SEC=10

# Required by api.weather.gov
NWS_USER_AGENT=(esp32-weather-slideshow, contact@example.com)

# Radar (override if defaults change)
# RIDGE_REFLECTIVITY_URL=https://radar.weather.gov/ridge/standard/KFWS_0.gif
# RIDGE_VELOCITY_URL=https://radar.weather.gov/ridge/standard/base_velocity/KFWS_0.gif
