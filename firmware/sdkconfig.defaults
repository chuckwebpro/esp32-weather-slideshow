CONFIG_IDF_TARGET="esp32p4"

# ESP-Hosted SDIO timing (default 100 Hz causes jitter warnings)
CONFIG_FREERTOS_HZ=1000

# Elecrow CrowPanel Advanced 10.1" — ESP32-P4 rev v1.x, 16MB flash, 32MB PSRAM (HEX)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# LVGL (RGB565 panel — Elecrow Lesson16)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Elecrow BSP (1024x600 EK79007 + GT911 on I2C)
CONFIG_BSP_I2C_ENABLED=y
CONFIG_BSP_DISPLAY_ENABLED=y
CONFIG_BSP_TOUCH_ENABLED=y

# WiFi (via ESP32-C6 coprocessor on CrowPanel — follow Elecrow sdkconfig)
CONFIG_ESP_WIFI_ENABLED=y

# mDNS hostname brain.local
CONFIG_LWIP_LOCAL_HOSTNAME="brain"

# HTTP client buffer
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Partition (16 MB flash — factory app 4 MB; see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# JPEG slides (1024x600 RGB565 ~1.2MB) use heap_caps_malloc(..., MALLOC_CAP_SPIRAM) when SPIRAM is on
