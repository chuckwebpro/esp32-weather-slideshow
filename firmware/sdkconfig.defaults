CONFIG_IDF_TARGET="esp32p4"

# LVGL
CONFIG_LV_USE_GESTURE_RECOGNITION=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# WiFi (via ESP32-C6 coprocessor on CrowPanel — follow Elecrow sdkconfig)
CONFIG_ESP_WIFI_ENABLED=y

# mDNS hostname brain.local
CONFIG_LWIP_LOCAL_HOSTNAME="brain"

# HTTP client buffer
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Partition
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# JPEG slides (1024x600 RGB565 ~1.2MB — enable PSRAM in menuconfig for CrowPanel)
# CONFIG_SPIRAM=y
